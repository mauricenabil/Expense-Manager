{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Expense Manager",
  "version": "1.0.0",
  "identifier": "com.personal.expensemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 360,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Expense Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 Personal Expense Manager",
    "category": "Finance",
    "shortDescription": "Personal expense tracking and budgeting",
    "longDescription": "A professional personal expense manager built with Tauri. Track expenses, manage budgets, analyze spending patterns, and maintain savings goals — all stored locally and privately.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {}
    }
  }
}
